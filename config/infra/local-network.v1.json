{
  "contract": "cgn.local-network.v1",
  "ticket": "CGN-40",
  "cloudResourcesEnabled": false,
  "cluster": {
    "name": "cgn-local",
    "apiServerAddress": "127.0.0.1",
    "podSubnet": "10.244.0.0/16",
    "serviceSubnet": "10.96.0.0/16"
  },
  "ingress": {
    "bindAddress": "127.0.0.1",
    "httpPort": 8080,
    "httpsPort": 8443,
    "publicByDefault": false
  },
  "namespaces": [
    "cgn-system",
    "cgn-apps",
    "cgn-data"
  ],
  "dataServices": {
    "postgres": {
      "namespace": "cgn-data",
      "exposure": "ClusterIP"
    },
    "redis": {
      "namespace": "cgn-data",
      "exposure": "ClusterIP"
    },
    "kafka": {
      "namespace": "cgn-data",
      "exposure": "ClusterIP"
    }
  },
  "networkPolicy": {
    "defaultDenyNamespaces": ["cgn-system", "cgn-apps", "cgn-data"],
    "defaultDenyIngress": true,
    "defaultDenyEgress": true,
    "allowDnsEgress": true
  }
}
