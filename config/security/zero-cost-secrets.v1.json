{
  "schema": "cgn.zero-cost-secrets.v1",
  "ticket": "CGN-99",
  "cost": {
    "paidSecretProviderRequired": false,
    "approvedSources": [
      "local-environment",
      "github-actions-encrypted-secrets",
      "kubernetes-secret"
    ]
  },
  "local": {
    "exampleFile": "infra/postgres/.env.example",
    "realValuesInGit": false,
    "requiredConfiguration": "config/infra/postgres-databases.v1.json"
  },
  "githubActions": {
    "secretExpression": "${{ secrets.NAME }}",
    "injectAtJobRuntime": true,
    "printSecretValues": false
  },
  "kubernetes": {
    "resourceKind": "Secret",
    "commitRenderedSecretManifests": false,
    "scope": "local-or-non-production-only"
  },
  "rotation": {
    "procedureDocumented": true,
    "rotateImmediatelyAfterExposure": true,
    "verifyReplacementBeforeRevokingOldValue": true
  },
  "scanning": {
    "scanner": "Gitleaks",
    "pullRequestAndMain": true,
    "failOnDetection": true,
    "allowlistByDefault": false
  },
  "futureMigration": {
    "managedProviderRequiresSeparateReview": true,
    "providerAbstractionBeforeMigration": true,
    "paidInfrastructureRequiresExplicitApproval": true
  }
}
