{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgn.example/contracts/evidence-upload-policy.v1.schema.json",
  "title": "CGN Evidence Upload Policy v1",
  "description": "Approved private evidence upload, quarantine, validation, scan and signed URL policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "maxFileSizeBytes",
    "signedUploadUrlTtlSeconds",
    "signedDownloadUrlTtlSeconds",
    "allowedFiles",
    "privateObjectsOnly",
    "quarantineUntilClean",
    "ownerAuthorizationRequired",
    "postUploadValidationRequired",
    "scannerFailureMode"
  ],
  "properties": {
    "contract": { "const": "cgn.evidence-upload-policy.v1" },
    "maxFileSizeBytes": { "type": "integer", "minimum": 1, "maximum": 10485760 },
    "signedUploadUrlTtlSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
    "signedDownloadUrlTtlSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
    "allowedFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["extensions", "contentType"],
        "properties": {
          "extensions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [".pdf", ".jpg", ".jpeg", ".png"]
            }
          },
          "contentType": {
            "enum": ["application/pdf", "image/jpeg", "image/png"]
          }
        }
      }
    },
    "privateObjectsOnly": { "const": true },
    "quarantineUntilClean": { "const": true },
    "ownerAuthorizationRequired": { "const": true },
    "postUploadValidationRequired": { "const": true },
    "scannerFailureMode": { "const": "fail_closed" }
  }
}
