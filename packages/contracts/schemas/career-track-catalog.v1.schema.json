{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgn.local/schemas/career-track-catalog.v1.schema.json",
  "title": "CareerTrackCatalogV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "skillCatalogVersion",
    "tracks"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "skillCatalogVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/track" }
    }
  },
  "$defs": {
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "skills", "sources"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^track\\.[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "displayName": { "type": "string", "minLength": 1 },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/trackSkill" }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "trackSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skillId", "requirement", "prerequisites", "sourceIds"],
      "properties": {
        "skillId": {
          "type": "string",
          "pattern": "^skill\\.[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "requirement": { "enum": ["required", "optional"] },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^skill\\.[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          }
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "publisher",
        "title",
        "url",
        "version",
        "accessedOn"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "official_documentation" },
        "publisher": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "version": { "type": "string", "minLength": 1 },
        "accessedOn": { "type": "string", "format": "date" }
      }
    }
  }
}
