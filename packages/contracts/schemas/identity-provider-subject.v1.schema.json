{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgn.local/schemas/identity-provider-subject.v1.schema.json",
  "title": "CGN Identity Provider Subject v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "issuer", "subject", "accountId", "linkedAt"],
  "properties": {
    "contract": { "const": "cgn.identity.provider-subject.v1" },
    "issuer": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "accountId": { "type": "string", "format": "uuid" },
    "linkedAt": { "type": "string", "format": "date-time" }
  }
}
