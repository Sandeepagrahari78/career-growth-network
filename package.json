{
  "name": "career-growth-network",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "agent:context": "node scripts/agent-context.mjs",
    "memory:log": "node scripts/memory-log.mjs",
    "memory:check": "node scripts/memory-check.mjs",
    "demo:module-a": "node demo/module-a/index.mjs",
    "demo:module-b": "node demo/module-b/index.mjs",
    "demo:handoff": "node scripts/demo-handoff.mjs",
    "demo:sync": "node scripts/run-sync-demo.mjs",
    "format:check": "pnpm dlx prettier@3.6.2 --check \"scripts/ci/**/*.mjs\" \"scripts/infra/**/*.mjs\" \"services/health-demo/**/*.{ts,mjs,json}\" \"tests/**/*.{mjs,js,md}\" \".github/**/*.{yml,yaml,md}\" \"infra/**/*.{yml,yaml}\" \"package.json\" \"eslint.config.js\"",
    "lint": "pnpm dlx eslint@9.39.1 scripts/ci scripts/infra services/health-demo/server.mjs eslint.config.js",
    "typecheck": "pnpm --package=typescript@5.9.3 dlx tsc --noEmit -p services/health-demo/tsconfig.json",
    "test:unit": "pnpm dlx vitest@3.2.4 run --globals services/health-demo/src/health.test.mjs",
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "build": "pnpm --package=typescript@5.9.3 dlx tsc -p services/health-demo/tsconfig.json",
    "ci:verify-branch": "node scripts/ci/verify-branch.mjs",
    "ci:detect-changes": "node scripts/ci/detect-changes.mjs",
    "ci:gitops": "node scripts/ci/validate-argocd-staging.mjs",
    "ci:quick": "pnpm ci:boundaries && pnpm ci:gitops && pnpm ci:helm && pnpm ci:helm-promotion && pnpm ci:migration-job && pnpm ci:probes && pnpm ci:autoscaling && pnpm ci:workload-identity && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:contracts && pnpm build",
    "ci:full": "pnpm memory:check && pnpm demo:sync && pnpm ci:quick",
    "ci:boundaries": "node scripts/ci/verify-workspace-boundaries.mjs",
    "ci:helm": "node scripts/ci/validate-helm-base.mjs",
    "ci:helm-promotion": "node scripts/ci/validate-helm-promotion.mjs",
    "ci:migration-job": "node scripts/ci/validate-database-migration-job.mjs",
    "ci:probes": "node scripts/ci/validate-kubernetes-probes.mjs",
    "ci:autoscaling": "node scripts/ci/validate-autoscaling-disruption.mjs",
    "ci:workload-identity": "node scripts/ci/validate-workload-identity.mjs",
    "demo:three-agents": "node scripts/run-three-agent-demo.mjs"
  }
}
